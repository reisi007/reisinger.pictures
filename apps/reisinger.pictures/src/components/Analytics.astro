<script>
  import { trackEvent } from "../tracking";

  document.addEventListener("astro:after-swap", () => {
    trackEvent("pageview", { url: window.location.pathname + window.location.search });
  });

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;
    if (!target) return;

    const contactEl = target.closest<HTMLElement>("[data-contact-open]");
    if (contactEl) {
      const project = contactEl.dataset.trackProject;
      trackEvent("contact_open", {
        source: contactEl.dataset.contactOpen ?? "unknown",
        ...(project ? { project } : {})
      });
      return;
    }

    const contactLink = target.closest<HTMLAnchorElement>("a[href*='#kontakt']");
    if (contactLink) {
      trackEvent("contact_open", { source: "contact_link" });
      return;
    }

    const outbound = target.closest<HTMLAnchorElement>("a[target='_blank'], a[href^='http']");
    if (outbound && new URL(outbound.href).hostname !== window.location.hostname) {
      trackEvent("outbound_link", { url: outbound.href });
    }
  });
</script>
