---
import ReviewCards from "./ReviewCards.astro";
import { type ReviewProps } from "./Types";

type Props = {
  slug?: string,
  slugs?: string[],
} & ReviewProps

const { slug, slugs = slug !== undefined ? [slug] : [], displayLargeImage = false, showDetailLink = true, ...reviewProps } = Astro.props;
---

<ReviewCards slugs={slugs} displayLargeImage={displayLargeImage} showDetailLink={showDetailLink} {...reviewProps} class="mb-8" />
